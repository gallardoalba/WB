[Unit]
Description=Wanderbibliothek · mantenimiento (caducidades, purgas, correo)
Documentation=file:/srv/wanderbibliothek/current/deploy/README.md
After=wanderbibliothek.service

[Service]
Type=oneshot
User=wanderbibliothek
Group=wanderbibliothek
EnvironmentFile=/etc/wanderbibliothek/env
UMask=0077
# El token viaja por la cabecera Authorization; el endpoint responde 404 si
# MAINTENANCE_TOKEN no está definido. nginx además solo lo deja entrar desde
# loopback (ver deploy/nginx.conf).
# `sh -c` expande la variable: mientras dura la llamada, el token es visible en
# `/proc/<pid>/cmdline` para las cuentas locales. Si eso importa, mueve la
# cabecera a un fichero de configuración de curl (`curl -K`, modo 0600).
#
# Un 429 significa «esta pasada sobra», no «el mantenimiento está roto»: se
# anota en el registro y la unidad termina bien. Cualquier otro código (401 por
# token cambiado, 5xx de la aplicación) sí la marca como fallida.
ExecStart=/bin/sh -c 'codigo=$(curl -sS -o /tmp/mantenimiento.json -w "%{http_code}" -X POST -H "Authorization: Bearer $MAINTENANCE_TOKEN" http://127.0.0.1:3000/api/cron/maintenance); cat /tmp/mantenimiento.json; echo; [ "$codigo" = 200 ] || [ "$codigo" = 429 ]'
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
