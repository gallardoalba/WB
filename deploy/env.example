# Entorno del servicio: /etc/wanderbibliothek/env
#
#   sudo install -m 600 -o root -g root deploy/env.example /etc/wanderbibliothek/env
#   sudo -e /etc/wanderbibliothek/env
#
# Se lee desde systemd (EnvironmentFile), no desde Next: cualquier cambio
# requiere `sudo systemctl restart wanderbibliothek`.
#
# Genera los secretos con:  openssl rand -hex 32

# --- Obligatorias: si faltan, el arranque avisa y responde 500 -------------

# URL pública SIN barra final. Debe ser https:// (la cookie de sesión es
# __Host- y exige Secure; sobre HTTP el navegador la descarta).
NEXT_PUBLIC_SITE_URL=https://biblioteca.example.com

# Proveedor de correo. Sin uno, nadie puede confirmar su cuenta ni recuperar
# la contraseña (en producción la confirmación es obligatoria para publicar).
#
# Opción A — Brevo, integrado en la aplicación (la que usa el despliegue de
# referencia). La clave está en Brevo → SMTP y API → Claves API (v3). El
# remitente tiene que ser de un dominio ya autenticado en la cuenta.
BREVO_API_KEY=
# MAIL_FROM="Wanderbibliothek <no-reply@biblioteca.example.com>"
#
# Opción B — cualquier otro servicio. Recibe POST {to, subject, text}.
# Si defines las dos cosas, manda el webhook y la clave de Brevo no se usa.
# MAIL_WEBHOOK_URL=https://api.tu-proveedor.example/send
# MAIL_WEBHOOK_TOKEN=

# Clave de 32 bytes para cifrar los secretos TOTP. Sin ella no se puede activar
# la verificación en dos pasos y, por tanto, la administración queda bloqueada.
# Clave activa de cifrado (32 bytes en hex o base64).
APP_ENCRYPTION_KEY=
# Id legible de la clave activa (opcional). Al rotar, pon aquí la nueva clave en
# APP_ENCRYPTION_KEY y la anterior en APP_ENCRYPTION_OLD_KEYS, ejecuta
# `npm run rotate:secrets` y retira la vieja cuando el informe diga 0 pendientes.
# APP_ENCRYPTION_KEY_ID=2026-11
# APP_ENCRYPTION_OLD_KEYS=

# --- Operación ------------------------------------------------------------

# Ruta absoluta de la base, fuera del directorio de la aplicación.
WANDERBIBLIOTHEK_DB=/var/lib/wanderbibliothek/wanderbibliothek.db

# Hay un proxy delante (nginx): activa cuotas por IP real.
TRUST_PROXY=1
# Saltos de confianza en X-Forwarded-For (nginx directo = 1; CDN + nginx = 2).
TRUSTED_PROXY_HOPS=1

# Token del cron de mantenimiento (POST /api/cron/maintenance).
MAINTENANCE_TOKEN=

# Aviso de errores de servidor fuera de la consola (opcional pero recomendable).
ERROR_WEBHOOK_URL=
ERROR_WEBHOOK_TOKEN=

# --- Copias de seguridad --------------------------------------------------

WANDERBIBLIOTHEK_BACKUP_DIR=/var/backups/wanderbibliothek
WANDERBIBLIOTHEK_BACKUP_KEEP=14
# Si defines clave, las copias se guardan cifradas (.enc). Guárdala aparte:
# sin ella no se pueden restaurar.
WANDERBIBLIOTHEK_BACKUP_KEY=
# Gancho tras la copia (rsync a otro host, rclone, S3…).
# WANDERBIBLIOTHEK_BACKUP_HOOK=rsync -a "$BACKUP_FILE" backup@host:/srv/wanderbibliothek/

# --- Registro y moderación ------------------------------------------------

# Exigir correo confirmado (por defecto ya se exige en producción).
# REQUIRE_EMAIL_VERIFICATION=1
# Días de auditoría de moderación (0 = se conserva siempre).
AUDIT_RETENTION_DAYS=730

# Caché de portadas (se descargan desde el servidor, no desde el navegador).
# Por defecto, una carpeta `covers` junto a la base de datos.
# WANDERBIBLIOTHEK_COVER_CACHE=/var/lib/wanderbibliothek/covers
# Clave opcional de Google Books para las portadas: sin ella se usa la cuota
# anónima, que se agota enseguida (Open Library sigue funcionando).
# GOOGLE_BOOKS_API_KEY=AIza...

# --- Solo la primera vez ------------------------------------------------

# Primer administrador. Retíralas después: no hacen falta para arrancar.
# ADMIN_EMAIL=admin@biblioteca.example.com
# ADMIN_PASSWORD=

# Nunca en producción (crea cuentas demo con contraseña conocida).
# SEED_DEMO=0

# --- Captcha (opcional, pero OJO: es de BUILD) ---------------------------

# NEXT_PUBLIC_TURNSTILE_SITE_KEY se incrusta en el bundle del cliente y el
# proxy construye la CSP con ella: definirla aquí NO basta. Para activarla hay
# que pasarla al compilar (`NEXT_PUBLIC_TURNSTILE_SITE_KEY=… npm run build`, o
# como build arg en Docker) y poner el secreto en el entorno del servicio.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA…
# TURNSTILE_SECRET=

# --- Páginas legales (obligatorias antes de abrir el servicio) ------------

# Rellenan /privacidad y /aviso-legal. Sin ellas las páginas se publican con un
# aviso visible de que faltan datos, y el arranque lo recuerda en el log.
# El aviso legal (Impressum, § 5 DDG) y la política de privacidad (art. 13
# RGPD) son obligatorios para un servicio abierto en Alemania; el texto que ya
# trae la aplicación hay que revisarlo con quien asuma la responsabilidad.
# LEGAL_CONTROLLER=Nombre y apellidos / razón social
# LEGAL_ADDRESS=Calle 1, 00000 Ciudad, Alemania
# LEGAL_CONTACT_EMAIL=privacidad@tudominio.example
# LEGAL_VAT_ID=DE000000000
# LEGAL_REGISTER=Vereinsregister Amtsgericht Stuttgart, VR 12345
# LEGAL_PHONE=+49 000 000000

# Arrancar aunque falte alguna variable obligatoria (solo para pruebas).
# WANDERBIBLIOTHEK_SKIP_ENV_CHECK=1
