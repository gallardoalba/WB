# Entorno del servicio: /etc/wanderbibliothek/env
#
#   sudo install -m 600 -o root -g root deploy/env.example /etc/wanderbibliothek/env
#   sudo -e /etc/wanderbibliothek/env
#
# Se lee desde systemd (EnvironmentFile), no desde Next: cualquier cambio
# requiere `sudo systemctl restart wanderbibliothek`.
#
# Genera los secretos con:  openssl rand -hex 32

# --- Obligatorias: si faltan, el arranque avisa y responde 500 -------------

# URL pública SIN barra final. Debe ser https:// (la cookie de sesión es
# __Host- y exige Secure; sobre HTTP el navegador la descarta).
NEXT_PUBLIC_SITE_URL=https://biblioteca.example.com

# Proveedor de correo: recibe POST {to, subject, text} (Resend, SES, Postmark…).
# Sin esto nadie puede confirmar su cuenta ni recuperar la contraseña.
MAIL_WEBHOOK_URL=https://api.tu-proveedor.example/send
MAIL_WEBHOOK_TOKEN=

# Clave de 32 bytes para cifrar los secretos TOTP. Sin ella no se puede activar
# la verificación en dos pasos y, por tanto, la administración queda bloqueada.
APP_ENCRYPTION_KEY=

# --- Operación ------------------------------------------------------------

# Ruta absoluta de la base, fuera del directorio de la aplicación.
WANDERBIBLIOTHEK_DB=/var/lib/wanderbibliothek/wanderbibliothek.db

# Hay un proxy delante (nginx): activa cuotas por IP real.
TRUST_PROXY=1
# Saltos de confianza en X-Forwarded-For (nginx directo = 1; CDN + nginx = 2).
TRUSTED_PROXY_HOPS=1

# Token del cron de mantenimiento (POST /api/cron/maintenance).
MAINTENANCE_TOKEN=

# Aviso de errores de servidor fuera de la consola (opcional pero recomendable).
ERROR_WEBHOOK_URL=
ERROR_WEBHOOK_TOKEN=

# --- Copias de seguridad --------------------------------------------------

WANDERBIBLIOTHEK_BACKUP_DIR=/var/backups/wanderbibliothek
WANDERBIBLIOTHEK_BACKUP_KEEP=14
# Si defines clave, las copias se guardan cifradas (.enc). Guárdala aparte:
# sin ella no se pueden restaurar.
WANDERBIBLIOTHEK_BACKUP_KEY=
# Gancho tras la copia (rsync a otro host, rclone, S3…).
# WANDERBIBLIOTHEK_BACKUP_HOOK=rsync -a "$BACKUP_FILE" backup@host:/srv/wanderbibliothek/

# --- Registro y moderación ------------------------------------------------

# Exigir correo confirmado (por defecto ya se exige en producción).
# REQUIRE_EMAIL_VERIFICATION=1
# Días de auditoría de moderación (0 = se conserva siempre).
AUDIT_RETENTION_DAYS=730

# --- Solo la primera vez ------------------------------------------------

# Primer administrador. Retíralas después: no hacen falta para arrancar.
# ADMIN_EMAIL=admin@biblioteca.example.com
# ADMIN_PASSWORD=

# Nunca en producción (crea cuentas demo con contraseña conocida).
# SEED_DEMO=0

# Arrancar aunque falte alguna variable obligatoria (solo para pruebas).
# WANDERBIBLIOTHEK_SKIP_ENV_CHECK=1
