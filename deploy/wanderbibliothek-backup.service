[Unit]
Description=Wanderbibliothek · copia de seguridad de la base
Documentation=https://github.com/gallardoalba/WB/blob/main/deploy/README.md
After=wanderbibliothek.service docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/wanderbibliothek/env
EnvironmentFile=-/etc/wanderbibliothek/image.env
RuntimeDirectory=wanderbibliothek-backup
RuntimeDirectoryMode=0700
ExecStart=/usr/local/sbin/wanderbibliothek-backup
UMask=0077
Nice=10
IOSchedulingClass=idle
# El cliente Docker requiere root; el contenedor y el gancho externo usan el
# UID sin privilegios de la aplicación.
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/run/wanderbibliothek-backup /var/lib/wanderbibliothek /var/backups/wanderbibliothek
