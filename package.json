{
  "name": "wanderbibliothek",
  "version": "1.0.29",
  "private": true,
  "description": "Intercambio de libros físicos entre lectores: catálogo por ciudad y mensajería cifrada de extremo a extremo.",
  "license": "AGPL-3.0-only",
  "author": "gallardoalba",
  "homepage": "https://github.com/gallardoalba/wanderbibliothek",
  "repository": {
    "type": "git",
    "url": "https://github.com/gallardoalba/wanderbibliothek.git"
  },
  "bugs": {
    "url": "https://github.com/gallardoalba/wanderbibliothek/issues"
  },
  "keywords": [
    "books",
    "book-exchange",
    "nextjs",
    "sqlite",
    "self-hosted"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --enable-source-maps --import tsx --test \"tests/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "db:reset": "rm -f .data/wanderbibliothek.db .data/wanderbibliothek.db-wal .data/wanderbibliothek.db-shm",
    "db:schema-snapshot": "node --import tsx scripts/schema-snapshot.ts",
    "db:backup": "node --import tsx scripts/backup.ts",
    "db:decrypt": "node --import tsx scripts/decrypt-backup.ts",
    "db:verify": "node --import tsx scripts/verify-backup.ts",
    "db:restore-drill": "node --import tsx scripts/restore-drill.ts",
    "admin:create": "node --import tsx scripts/create-admin.ts",
    "moderator:create": "node --import tsx scripts/create-admin.ts --moderator",
    "admin:2fa-off": "node --import tsx scripts/disable-2fa.ts",
    "rotate:secrets": "node --import tsx scripts/rotate-secrets.ts",
    "legal:env": "node --import tsx scripts/legal-env.ts",
    "user:verify": "node --import tsx scripts/verify-user.ts",
    "meta:refresh": "node --import tsx scripts/refresh-metadata.ts",
    "mail:test": "node --import tsx scripts/mail-test.ts",
    "mail:health": "node --import tsx scripts/mail-health.ts",
    "mastodon:test": "node --import tsx scripts/mastodon.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "informe:accesos": "bash deploy/informe-accesos.sh",
    "informe:moderacion": "node --import tsx scripts/informe-moderacion.ts",
    "transparency:snapshot": "node --import tsx scripts/transparency-snapshot.ts",
    "transparency:key": "node --import tsx scripts/transparency-key.ts",
    "transparency:verify": "node --import tsx scripts/verify-transparency.ts",
    "bench:sqlite": "node --import tsx scripts/bench-sqlite.ts",
    "bench:migrate": "node --import tsx scripts/bench-migrations.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test --project=firefox-smoke --project=webkit-smoke",
    "test:coverage": "node --enable-source-maps --import tsx --test --experimental-test-coverage --test-coverage-lines=92 --test-coverage-functions=88 --test-coverage-branches=80 \"tests/*.test.ts\"",
    "audit:dev": "node --import tsx scripts/audit-dev.ts",
    "db:works": "node --import tsx scripts/works-report.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.5",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fast-check": "^4.10.2",
    "tailwindcss": "4.3.5",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    }
  }
}
