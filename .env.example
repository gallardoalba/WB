# Copia esta plantilla a `.env.local` (desarrollo) o define estas variables en el
# entorno de despliegue.

# Ruta del fichero SQLite (por defecto .data/wanderbibliothek.db)
# WANDERBIBLIOTHEK_DB=/var/lib/wanderbibliothek/wanderbibliothek.db

# URL pública: la usan sitemap.xml, robots.txt y los canonical.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pon 1 solo si hay un proxy o CDN delante: activa las cuotas por IP real y
# acepta X-Forwarded-Host para la guardia de origen.
# TRUST_PROXY=1
# Saltos de confianza en X-Forwarded-For (nginx directo = 1; CDN + nginx = 2).
# TRUSTED_PROXY_HOPS=1

# Token del cron de mantenimiento (POST /api/cron/maintenance).
# MAINTENANCE_TOKEN=cambia-esto-por-un-secreto-largo

# Primer administrador (solo se usa si no existe ninguna cuenta admin).
# ADMIN_EMAIL=admin@tudominio.com
# ADMIN_PASSWORD=una-contraseña-de-al-menos-12-caracteres

# Sembrar los datos de demostración. Por defecto solo ocurre fuera de producción.
# SEED_DEMO=0

# Exigir el correo confirmado para publicar, solicitar, comentar o escribir.
# REQUIRE_EMAIL_VERIFICATION=1

# Endpoint del proveedor de correo (recibe {to, subject, text}).
# MAIL_WEBHOOK_URL=https://api.tu-proveedor.example/send
# Token opcional para el proveedor de correo (se envía como Bearer).
# MAIL_WEBHOOK_TOKEN=

# Clave de 32 bytes (hex o base64) para cifrar secretos reversibles (TOTP).
# Obligatoria en producción.
# APP_ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-hex-o-base64
# Id legible de la clave activa (opcional; por defecto uno derivado de la clave).
# APP_ENCRYPTION_KEY_ID=2026-11
# Claves anteriores solo para LEER, separadas por comas, mientras se rota:
#   APP_ENCRYPTION_OLD_KEYS=<clave-vieja>,<otra>
#   APP_ENCRYPTION_OLD_KEYS=2026-10:<clave-vieja>
# Tras rotar, ejecuta `npm run rotate:secrets` para volver a cifrar los datos.
# En desarrollo, sin clave: WANDERBIBLIOTHEK_ALLOW_PLAINTEXT=1 (nunca en producción).

# Carpeta de copias de seguridad (por defecto .data/backups).
# WANDERBIBLIOTHEK_BACKUP_DIR=/var/backups/wanderbibliothek
# Copias que se conservan (rotación) y gancho de copia externa.
# WANDERBIBLIOTHEK_BACKUP_KEEP=14
# WANDERBIBLIOTHEK_BACKUP_KEY=32-bytes-en-hex-o-base64-para-cifrar-las-copias
# WANDERBIBLIOTHEK_BACKUP_HOOK=rsync -a "$BACKUP_FILE" backup@host:/srv/wanderbibliothek/

# Captcha opcional para el registro (Cloudflare Turnstile).
# Sin estas variables se usa la barrera honeypot + tiempo mínimo.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Webhook de errores de servidor (JSON: level, message, stack, context).
# ERROR_WEBHOOK_URL=
# ERROR_WEBHOOK_TOKEN=

# Días que se conserva la auditoría de moderación (0 = para siempre).
# AUDIT_RETENTION_DAYS=730

# Datos del responsable que se publican en /privacidad y /aviso-legal.
# Sin ellos las páginas salen con un aviso de que están incompletas.
# LEGAL_CONTROLLER=Nombre y apellidos / razón social
# LEGAL_ADDRESS=Calle 1, 00000 Ciudad, Alemania
# LEGAL_CONTACT_EMAIL=privacidad@tudominio.example
# LEGAL_VAT_ID=DE000000000
# LEGAL_REGISTER=Vereinsregister Amtsgericht Stuttgart, VR 12345
# LEGAL_PHONE=+49 000 000000

# Dónde se cachean las portadas descargadas de Open Library.
# Por defecto, una carpeta `covers` junto a la base de datos.
# WANDERBIBLIOTHEK_COVER_CACHE=/var/lib/wanderbibliothek/covers
# Clave opcional de Google Books para las portadas: sin ella se usa la cuota
# anónima, que se agota enseguida (Open Library sigue funcionando).
# GOOGLE_BOOKS_API_KEY=AIza...

# Arrancar aunque falte una variable obligatoria de producción. Solo para
# pruebas: en un servidor real deja la web inservible sin querer.
# WANDERBIBLIOTHEK_SKIP_ENV_CHECK=1

