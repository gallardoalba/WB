# Normaliza finales de línea en cualquier sistema operativo.
* text=auto eol=lf

# Binarios: nunca convertirlos.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary

# Scripts y configuración sin dependencia de plataforma.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
